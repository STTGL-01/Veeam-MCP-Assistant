# Veeam's vbr-mcp connection. Copy to /etc/veeam-assistant/vbr.env (README step 22).
# VBR_BASE_URL keeps :9419 and has no slash at the end. Change the three placeholder lines.
VBR_BASE_URL=https://REPLACE-VBR-NAME:9419
VBR_USERNAME=REPLACE-DOMAIN\REPLACE-USER
VBR_PASSWORD=REPLACE-PASSWORD
VBR_VERIFY_TLS=false
