# Website settings. Copy to /etc/veeam-assistant/app.env (README step 20).
# The Claude API key is NOT kept here until you do README step 44; that step adds your own.
# Docker reads this file literally: no quotes, no comments after a value.
SITE_TITLE=Veeam Assistant
SITE_SUBTITLE=Veeam Intelligence
COOKIE_SECURE=true
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
MAX_CONCURRENT_QUESTIONS=4
ADMIN_CAN_APPROVE=true
TOOL_APPROVAL_TIMEOUT_SEC=1500
CHAT_TURN_TIMEOUT_SEC=3600
PUBLIC_ORIGIN=
LOG_MCP=false
