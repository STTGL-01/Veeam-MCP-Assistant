# REST API server connection. Copy to /etc/veeam-assistant/vbr-extra.env (README step 23).
# The account needs the Veeam Backup Administrator role to delete things.
VBR_URL=https://REPLACE-VBR-NAME:9419
VBR_USERNAME=REPLACE-DOMAIN\REPLACE-USER
VBR_PASSWORD=REPLACE-PASSWORD
VBR_ACCEPT_SELF_SIGNED_CERT=true
VBR_WAIT_SEC=900
