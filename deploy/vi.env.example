# Veeam Intelligence connection. Copy to /etc/veeam-assistant/vi.env (README step 21).
# No quotes. No comments after a value. Change the three placeholder lines.
PRODUCT_NAME=vbr
WEB_URL=https://REPLACE-VBR-NAME/
ADMIN_USERNAME=REPLACE-DOMAIN\REPLACE-USER
ADMIN_PASSWORD=REPLACE-PASSWORD
ACCEPT_SELF_SIGNED_CERT=true
ACTION_CONFIRMATION_TIMEOUT_SEC=1500
